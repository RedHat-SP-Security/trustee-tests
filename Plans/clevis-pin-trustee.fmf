summary:
  Test clevis-pin-trustee with KBS and mock attestation

environment:
  TRUSTEE_RPM: "true"

description: |
  Tests clevis encrypt/decrypt round-trip with:
  - KBS in container (coco-as-builtin, insecure_key, allow_all.rego)
  - Sample attester fallback on non-TEE hardware
  - allow_all.rego policy to accept sample attestation evidence

  Requires a confidential VM for real TEE attestation.

provision:
  hardware:
    virtualization:
      confidential: true
    memory: ">= 8GB"

discover:
  how: fmf
  test:
    - /Functional/clevis-pin-trustee-basic-attestation

execute:
  how: tmt