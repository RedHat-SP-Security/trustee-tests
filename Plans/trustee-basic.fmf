summary:
  Plan with basic trustee attestation

environment:
  TRUSTEE_RPM: "true"

provision:
  hardware:
    memory: '>= 8 GiB'
    virtualization:
      confidential: true

discover:
  how: fmf
  test: 
   - /Setup/install_upstream_trustee
   - /Functional/trustee-basic-attestation

execute:
    how: tmt