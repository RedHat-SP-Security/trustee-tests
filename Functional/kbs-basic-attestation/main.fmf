description: |
    Running all services on localhost.
    Provide trustee basic attestation
contact: Patrik Koncity <pkoncity@redhat.com>
component:
  - trustee-guest-components
test: ./runtest.sh
framework: beakerlib
tag:
  - CI-Tier-1
require:
  - tss2
  - tss2-devel
  - tpm2-tss-devel
duration: 5m
enabled: true
/http:
    environment:
        HTTP_MODE: http
    id: 2066a319-18ae-4444-8ad7-57aed34534ab
/https:
    environment:
        HTTP_MODE: https
    id: 30407132-2344-463c-a2fe-fcf460ea6fa6
adjust+:
  - enabled: false
    when: arch != x86_64
    continue: false
